---
// 1. MODO ESTÁTICO (Velocidad pura)
export const prerender = true;

import Layout from '../layouts/Layout.astro';

// 2. FUNCIÓN DE IMÁGENES (Integrada aquí para evitar errores de importación)
const imgCloudinaryFetch = (url, width = 800) => {
  if (!url) return '';
  if (url.includes('images.unsplash.com')) {
    const separator = url.includes('?') ? '&' : '?';
    return `${url}${separator}w=${width}&auto=format&fit=crop&q=80`;
  }
  return url;
};

const pageTitle = 'Invycta Retail | Equipamiento de Minimarkets y Tiendas';

// 3. IMÁGENES
const bgHero = 'https://images.unsplash.com/photo-1578916171728-46686eac8d58?q=60&w=800&auto=format&fit=crop';
const imgProject1 = 'https://images.unsplash.com/photo-1542838132-92c53300491e?q=80&w=1974&auto=format&fit=crop'; 
const imgProject2 = 'https://images.unsplash.com/photo-1534723452862-4c874018d66d?q=80&w=2070&auto=format&fit=crop';

// 4. DATOS (Simulados para que no falle si no hay API aún)
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
let homeCats = [];
---

<Layout title={pageTitle}>
    <section class="relative h-[600px] flex items-center justify-center text-center text-white overflow-hidden">
        <div class="absolute inset-0 bg-black/60 z-10"></div>
        <div class="absolute inset-0 bg-cover bg-center z-0" style={`background-image: url('${bgHero}');`}></div>
        
        <div class="relative z-20 container mx-auto px-6">
            <span class="text-yellow-400 font-bold tracking-widest uppercase text-sm mb-4 block animate-fade-in-up">Expertos en Retail</span>
            <h1 class="text-4xl md:text-6xl font-extrabold mb-6 leading-tight animate-fade-in-up delay-100">
                Transformamos tu <br/> <span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 to-yellow-200">Minimarket</span>
            </h1>
            <p class="text-xl md:text-2xl text-gray-200 mb-10 max-w-2xl mx-auto animate-fade-in-up delay-200">
                Góndolas, checkouts y refrigeración con diseño estratégico para vender más.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-in-up delay-300">
                <a href="https://wa.me/51955271064" target="_blank" class="bg-yellow-500 hover:bg-yellow-400 text-gray-900 font-bold py-4 px-8 rounded-full transition duration-300 shadow-lg hover:shadow-yellow-500/50 flex items-center justify-center gap-2">
                    <i class="fas fa-whatsapp text-xl"></i> Asesoría Gratuita
                </a>
                <a href="#catalogo" class="bg-transparent border-2 border-white hover:bg-white/10 text-white font-bold py-4 px-8 rounded-full transition duration-300 backdrop-blur-sm">
                    Ver Catálogo
                </a>
            </div>
        </div>
    </section>

    <section class="py-20 bg-white">
        <div class="container mx-auto px-6">
            <h2 class="text-3xl font-bold text-center mb-12 text-gray-900">Proyectos Recientes</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <article class="group relative rounded-xl overflow-hidden shadow-lg cursor-pointer h-80">
                    <img src={imgCloudinaryFetch(imgProject1, 800)} class="w-full h-full object-cover transition duration-700 group-hover:scale-105" alt="Minimarket" loading="lazy">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex flex-col justify-end p-8">
                        <h3 class="text-white text-2xl font-bold">Minimarket Moderno</h3>
                        <span class="text-yellow-400 text-xs font-bold uppercase tracking-wider">Lima Norte</span>
                    </div>
                </article>
                <article class="group relative rounded-xl overflow-hidden shadow-lg cursor-pointer h-80">
                    <img src={imgCloudinaryFetch(imgProject2, 800)} class="w-full h-full object-cover transition duration-700 group-hover:scale-105" alt="Tienda" loading="lazy">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex flex-col justify-end p-8">
                        <h3 class="text-white text-2xl font-bold">Tienda de Conveniencia</h3>
                        <span class="text-yellow-400 text-xs font-bold uppercase tracking-wider">Arequipa</span>
                    </div>
                </article>
            </div>
        </div>
    </section>
</Layout>