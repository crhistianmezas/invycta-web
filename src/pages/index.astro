---
import Layout from '../layouts/Layout.astro';

// Datos de productos para mantener el código limpio y escalable
const products = [
  {
    title: "Góndola Central",
    desc: "Sistema modular de alta carga para exhibición masiva. Estantería reforzada.",
    icon: "M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"
  },
  {
    title: "Checkout",
    desc: "Mueble de caja ergonómico con banda transportadora y acabados en acero inoxidable.",
    icon: "M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"
  },
  {
    title: "Rack Pesado",
    desc: "Estructuras de almacenamiento industrial para trastienda y bodegas de alto volumen.",
    icon: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
  }
];
---

<Layout title="Invycta Retail | Ingeniería para Supermercados">
  <main class="flex flex-col min-h-screen">
    
    <section class="relative bg-slate-900 text-white py-24 lg:py-32 overflow-hidden border-b-8 border-orange-600">
      <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#ffffff33_1px,transparent_1px)] [background-size:16px_16px]"></div>
      
      <div class="container mx-auto px-6 relative z-10 text-center md:text-left">
        <div class="max-w-4xl">
          <span class="inline-block py-1 px-3 rounded bg-slate-800 text-orange-500 text-xs font-bold tracking-widest uppercase mb-4 border border-slate-700">
            Soluciones B2B
          </span>
          <h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight leading-tight mb-6">
            Ingeniería Retail para <br class="hidden md:block" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-slate-200 to-slate-500">
              Supermercados
            </span>
          </h1>
          <p class="text-xl text-slate-400 mb-10 max-w-2xl font-light leading-relaxed">
            Fabricamos góndolas y checkouts con <strong class="text-white font-semibold">precisión milimétrica</strong>. Optimizamos cada metro cuadrado de tu superficie comercial.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
            <a href="https://wa.me/51933438738?text=Hola%20Invycta,%20quiero%20cotizar%20un%20proyecto%20de%20equipamiento." target="_blank" class="inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white transition-all duration-200 bg-orange-600 border border-transparent rounded hover:bg-orange-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-600 shadow-[0_0_20px_rgba(234,88,12,0.3)]">
              Cotizar Proyecto
            </a>
            <a href="#catalogo" class="inline-flex items-center justify-center px-8 py-4 text-base font-bold text-slate-300 transition-all duration-200 bg-transparent border border-slate-600 rounded hover:bg-slate-800 hover:text-white focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-500">
              Ver Catálogo
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="catalogo" class="py-20 bg-slate-50">
      <div class="container mx-auto px-6">
        
        <div class="flex flex-col md:flex-row justify-between items-end mb-12 border-b border-slate-200 pb-6">
          <div>
            <h2 class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight">Equipamiento Esencial</h2>
            <p class="mt-2 text-slate-600">Manufactura robusta para tráfico intenso.</p>
          </div>
          <a href="#" class="hidden md:inline-flex items-center text-orange-600 font-semibold hover:text-orange-700 mt-4 md:mt-0">
            Ver todo el inventario 
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {products.map((item) => (
            <article class="group bg-white rounded-lg overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-200 flex flex-col h-full">
              <div class="h-56 bg-slate-100 flex items-center justify-center relative overflow-hidden group-hover:bg-slate-200 transition-colors">
                <svg class="w-16 h-16 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={item.icon}></path>
                </svg>
                <div class="absolute top-4 right-4 bg-slate-900 text-white text-[10px] font-bold px-2 py-1 rounded uppercase tracking-wider">
                  Industrial Grade
                </div>
              </div>
              
              <div class="p-6 flex-1 flex flex-col">
                <h3 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-orange-600 transition-colors">
                  {item.title}
                </h3>
                <p class="text-slate-600 text-sm leading-relaxed flex-1">
                  {item.desc}
                </p>
                <div class="mt-6 pt-4 border-t border-slate-100">
                  <span class="text-sm font-medium text-slate-500 group-hover:text-slate-900 transition-colors cursor-pointer flex items-center">
                    Ver especificaciones
                    <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                  </span>
                </div>
              </div>
            </article>
          ))}
        </div>

      </div>
    </section>
  </main>
</Layout>