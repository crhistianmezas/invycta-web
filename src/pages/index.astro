---
import Layout from '../layouts/Layout.astro';
import { PrismaClient } from '@prisma/client';

// 1. CONEXIÓN DIRECTA (Sin depender de un servidor externo)
const prisma = new PrismaClient();

const data = await prisma.webContent.findMany({
  where: { isActive: true },
  orderBy: { displayOrder: 'asc' }
});

// 2. CLASIFICAR DATOS (Igual que antes, pero con datos garantizados)
const hero = data.find(item => item.sectionType === 'HERO');
const sectors = data.filter(item => item.sectionType === 'SECTOR_CARD');
const products = data.filter(item => item.sectionType === 'PRODUCT_ROW');
const clients = data.filter(item => item.sectionType === 'CLIENT_LOGO');
const testimonials = data.filter(item => item.sectionType === 'TESTIMONIAL');

// Desconectar al terminar (Buena práctica en SSR)
await prisma.$disconnect();
---

<Layout title="Invycta Retail - Equipamiento Comercial">
  <main>
    
    {hero && (
      <section class="relative h-[600px] flex items-center justify-center text-white overflow-hidden bg-slate-900">
        <div class="absolute inset-0 z-0">
          <img src={hero.imageUrl} alt={hero.title} class="w-full h-full object-cover opacity-60" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 to-transparent"></div>
        </div>
        <div class="relative z-10 text-center px-4 max-w-4xl mx-auto mt-10">
          <h1 class="text-5xl md:text-7xl font-bold mb-6 tracking-tight leading-tight">{hero.title}</h1>
          <p class="text-xl md:text-2xl mb-10 text-gray-200 font-light">{hero.subtitle}</p>
          <a href={hero.ctaLink || "#contacto"} class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-10 rounded-full text-lg transition-all shadow-lg hover:shadow-blue-500/50">
            {hero.ctaText}
          </a>
        </div>
      </section>
    )}

    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-gray-900 text-center mb-12 uppercase tracking-wide">Nuestras Soluciones</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {sectors.map((sector) => (
            <div class="group relative h-96 rounded-2xl overflow-hidden shadow-xl cursor-pointer">
              <img src={sector.imageUrl} alt={sector.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>
              <div class="absolute bottom-0 left-0 p-8 w-full">
                <h3 class="text-2xl font-bold text-white mb-2">{sector.title}</h3>
                <span class="text-blue-400 font-semibold group-hover:text-blue-300 transition-colors">{sector.ctaText} &rarr;</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 space-y-24">
        {products.map((product, index) => (
          <div class={`flex flex-col md:flex-row items-center gap-12 ${index % 2 === 1 ? 'md:flex-row-reverse' : ''}`}>
            <div class="w-full md:w-1/2">
              <div class="relative rounded-2xl overflow-hidden shadow-2xl group">
                <img src={product.imageUrl} alt={product.title} class="w-full h-[400px] object-cover transition-transform duration-700 group-hover:scale-105" />
              </div>
            </div>
            <div class="w-full md:w-1/2 space-y-6">
              <h3 class="text-4xl font-bold text-gray-900">{product.title}</h3>
              <div class="w-20 h-2 bg-blue-600 rounded-full"></div>
              <p class="text-lg text-gray-600 leading-relaxed">{product.description}</p>
              <a href={product.ctaLink || "#"} class="inline-flex items-center gap-2 bg-slate-900 text-white font-semibold py-3 px-8 rounded-lg hover:bg-blue-600 transition-colors">
                {product.ctaText} &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="py-20 bg-slate-50 border-t border-gray-200">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-16 text-gray-800">Confían en Nosotros</h2>
        
        <div class="flex flex-wrap justify-center items-center gap-12 mb-20 opacity-60 grayscale hover:grayscale-0 transition-all duration-500">
          {clients.map(client => (
            <img src={client.imageUrl} alt={client.title} class="h-12 object-contain" />
          ))}
        </div>

        <div class="grid md:grid-cols-2 gap-8">
            {testimonials.map(t => (
                <div class="bg-white p-8 rounded-2xl shadow-lg border border-gray-100 flex gap-4 items-start">
                    <img src={t.imageUrl} class="w-16 h-16 rounded-full object-cover border-2 border-blue-500" />
                    <div>
                        <p class="text-gray-600 italic mb-4">"{t.description}"</p>
                        <h4 class="font-bold text-gray-900">{t.title}</h4>
                        <span class="text-sm text-blue-600">{t.subtitle}</span>
                    </div>
                </div>
            ))}
        </div>
      </div>
    </section>

  </main>

  <footer class="bg-slate-900 text-white pt-16 pb-8">
    <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
        <div>
            <h3 class="font-bold text-xl mb-4">INVYCTA RETAIL</h3>
            <p class="text-gray-400 text-sm">Expertos en equipamiento comercial y soluciones para retail en Perú.</p>
        </div>
        <div>
            <h4 class="font-bold mb-4">Productos</h4>
            <ul class="space-y-2 text-gray-400 text-sm">
                <li>Góndolas Metálicas</li>
                <li>Checkouts</li>
                <li>Lockers</li>
                <li>Racks Industriales</li>
            </ul>
        </div>
        <div>
            <h4 class="font-bold mb-4">Contacto</h4>
            <ul class="space-y-2 text-gray-400 text-sm">
                <li>ventas@invyctaretail.com</li>
                <li>+51 955 271 064</li>
                <li>Lima, Perú</li>
            </ul>
        </div>
    </div>
    <div class="border-t border-slate-800 pt-8 text-center text-gray-500 text-sm">
        <p>&copy; 2026 Invycta Retail. Desarrollado con Aruni Studio Technology.</p>
    </div>
  </footer>
</Layout>