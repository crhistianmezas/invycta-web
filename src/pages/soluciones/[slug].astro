---
// 1. MODO ESTÁTICO
export const prerender = true;

import Layout from '../../layouts/Layout.astro';

// 2. GENERACIÓN DE RUTAS (GetStaticPaths)
export async function getStaticPaths() {
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
  
  try {
    // Nota: Aquí llamamos a /business-line (Soluciones)
    const response = await fetch(`${API_URL}/business-line`);
    if (!response.ok) return [];
    const data = await response.json();

    return data.map((sol) => ({
      params: { slug: sol.slug },
      props: { solucionData: sol },
    }));
  } catch (e) {
    console.error("Error construyendo rutas de soluciones:", e);
    return [];
  }
}

// 3. RECUPERAR DATOS
const { solucionData } = Astro.props;

if (!solucionData) {
  return Astro.redirect('/404');
}

// Si la API trae productos relacionados a la solución, los usamos
const productos = solucionData.products || [];
---

<Layout title={`Soluciones para ${solucionData.name} | Invycta Retail`} description={`Equipamiento integral para ${solucionData.name}.`}>
  
  {/* HERO DE LA SOLUCIÓN */}
  <section class="relative h-[400px] flex items-center justify-center text-center text-white overflow-hidden bg-gray-900">
      <div class="absolute inset-0 bg-black/60 z-10"></div>
      {solucionData.image && (
        <div class="absolute inset-0 bg-cover bg-center z-0 opacity-50" style={`background-image: url('${solucionData.image}');`}></div>
      )}
      
      <div class="relative z-20 container mx-auto px-6">
          <span class="text-yellow-400 font-bold tracking-widest uppercase text-sm mb-4 block">Soluciones Integrales</span>
          <h1 class="text-4xl md:text-6xl font-extrabold mb-6 leading-tight">
              {solucionData.name}
          </h1>
          <a href="#contacto" class="bg-yellow-500 hover:bg-yellow-400 text-gray-900 font-bold py-3 px-8 rounded-full transition duration-300 shadow-lg inline-flex items-center gap-2">
              <i class="fab fa-whatsapp"></i> Asesoría Gratuita
          </a>
      </div>
  </section>

  <section class="py-16 bg-white">
      <div class="container mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div>
              <h2 class="text-3xl font-bold text-gray-900 mb-6">Equipamos tu {solucionData.name} de principio a fin</h2>
              <p class="text-gray-600 text-lg leading-relaxed mb-6">
                  {solucionData.description || `En Invycta Retail entendemos las necesidades específicas de un ${solucionData.name}. Diseñamos el flujo de clientes, maximizamos la exhibición y fabricamos el mobiliario exacto que necesitas.`}
              </p>
              <ul class="space-y-4 mb-8">
                  <li class="flex items-center gap-3 text-gray-700">
                      <i class="fas fa-check-circle text-invycta-blue"></i>
                      <span>Diseño de Layout estratégico</span>
                  </li>
                  <li class="flex items-center gap-3 text-gray-700">
                      <i class="fas fa-check-circle text-invycta-blue"></i>
                      <span>Fabricación a medida</span>
                  </li>
                  <li class="flex items-center gap-3 text-gray-700">
                      <i class="fas fa-check-circle text-invycta-blue"></i>
                      <span>Instalación a nivel nacional</span>
                  </li>
              </ul>
          </div>
          <div class="bg-gray-100 rounded-2xl p-8 h-80 flex items-center justify-center border-2 border-dashed border-gray-200">
             {/* Aquí podrías poner una galería o imagen secundaria */}
             <span class="text-gray-400 font-medium">Imagen Referencial del Proyecto</span>
          </div>
      </div>
  </section>

  {/* SECCIÓN DE PRODUCTOS RECOMENDADOS */}
  {productos.length > 0 && (
    <section class="py-16 bg-gray-50">
        <div class="container mx-auto px-6">
            <h2 class="text-3xl font-bold text-center mb-12">Mobiliario Recomendado</h2>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                {productos.map((prod) => (
                    <a href={`/producto/${prod.slug}`} class="bg-white p-4 rounded-xl shadow-sm hover:shadow-md transition">
                        <div class="aspect-square bg-gray-100 rounded-lg mb-4 overflow-hidden">
                             {prod.image && <img src={prod.image} class="w-full h-full object-cover" />}
                        </div>
                        <h3 class="font-bold text-gray-900">{prod.name}</h3>
                    </a>
                ))}
            </div>
        </div>
    </section>
  )}

</Layout>