---
// src/pages/soluciones/[slug].astro
export const prerender = true; // MODO SERVIDOR ACTIVO

import Layout from '../../layouts/Layout.astro';

const { slug } = Astro.params;
const API_URL = import.meta.env.DATABASE_URL_PUBLIC_API_URL;

let solucion = null;
let productos = [];
let error = false;

try {
  // 1. OBTENER DATOS DE LA SOLUCIÓN
  // (Igual que antes, pedimos todas y filtramos hasta que tengas el endpoint por slug)
  const res = await fetch(`${API_URL}/business-line`);
  
  if (res.ok) {
    const todas = await res.json();
    // Buscamos la solución específica (ej: Farmacia)
    solucion = todas.find(s => s.slug === slug);
    
    if (solucion) {
      // El backend ya trae los productos asociados gracias al "include: { products: true }"
      productos = solucion.products || [];
    } else {
      error = true;
    }
  } else {
    error = true;
  }
} catch (e) {
  console.error("Error fetching solucion:", e);
  error = true;
}

if (error) {
  return Astro.redirect('/404');
}
---

<Layout title={`Equipamiento para ${solucion.name} | Invycta Retail`} description={`Diseño y fabricación de muebles para ${solucion.name}. Soluciones integrales en Perú.`}>
  
  <div class="relative bg-gray-900 text-white py-20 lg:py-28 overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-40">
        {solucion.image ? (
            <img src={solucion.image} alt={`Diseño de ${solucion.name}`} class="w-full h-full object-cover" />
        ) : (
            <div class="w-full h-full bg-gradient-to-r from-gray-900 to-invycta-blue"></div>
        )}
    </div>
    
    <div class="container mx-auto px-4 relative z-10 text-center">
      <span class="inline-block py-1 px-3 border border-white/30 rounded-full text-xs font-bold tracking-widest uppercase mb-4 bg-white/10 backdrop-blur-sm">
        Soluciones Integrales
      </span>
      <h1 class="text-4xl md:text-6xl font-extrabold mb-6 leading-tight">
        Equipamiento para <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-200 to-white">{solucion.name}</span>
      </h1>
      <p class="text-xl text-gray-200 max-w-2xl mx-auto mb-8">
        {solucion.description || `Transformamos tu local en un ${solucion.name} moderno, funcional y vendedor. Desde el diseño hasta la instalación.`}
      </p>
      <a href="https://wa.me/51955271064" class="bg-yellow-500 hover:bg-yellow-400 text-gray-900 font-bold py-3 px-8 rounded-full shadow-lg transition transform hover:-translate-y-1 inline-flex items-center gap-2">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
        Cotizar Proyecto Completo
      </a>
    </div>
  </div>

  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row justify-between items-end mb-10 gap-4">
        <div>
          <h2 class="text-3xl font-bold text-gray-900">Mobiliario Recomendado</h2>
          <p class="text-gray-500 mt-2">Los productos esenciales para equipar tu {solucion.name}</p>
        </div>
      </div>

      {productos.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {productos.map((prod) => (
            <a href={`/producto/${prod.slug}`} class="bg-white rounded-xl shadow-sm hover:shadow-xl transition-all duration-300 group border border-gray-100">
              <div class="aspect-[4/3] overflow-hidden rounded-t-xl bg-gray-100 relative">
                 {prod.image ? (
                   <img src={prod.image} alt={prod.name} class="w-full h-full object-cover group-hover:scale-110 transition duration-500" />
                 ) : (
                    <div class="flex items-center justify-center w-full h-full text-gray-300 bg-gray-50 text-xs">Sin Foto</div>
                 )}
              </div>
              <div class="p-5">
                <span class="text-[10px] font-bold text-invycta-blue uppercase tracking-wider mb-1 block">Esencial</span>
                <h3 class="font-bold text-gray-900 text-lg mb-2 leading-tight group-hover:text-invycta-blue transition">{prod.name}</h3>
                <div class="text-sm font-medium text-gray-500">Ver características →</div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="bg-white p-8 rounded-xl border border-gray-200 text-center max-w-2xl mx-auto">
            <h3 class="text-lg font-bold text-gray-800">Estamos diseñando el catálogo digital para {solucion.name}</h3>
            <p class="text-gray-500 my-4">Pero ya tenemos cientos de fotos reales de proyectos terminados.</p>
            <a href="https://wa.me/51955271064" class="text-invycta-blue font-bold hover:underline">Pídelas por WhatsApp</a>
        </div>
      )}
    </div>
  </section>

  <section class="py-16 bg-white border-t border-gray-100">
      <div class="container mx-auto px-4 text-center">
          <h2 class="text-2xl font-bold text-gray-900 mb-8">¿Por qué elegir Invycta para tu {solucion.name}?</h2>
          <div class="grid md:grid-cols-3 gap-8">
              <div class="p-6">
                  <div class="w-12 h-12 bg-blue-50 text-invycta-blue rounded-full flex items-center justify-center mx-auto mb-4">
                      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  </div>
                  <h3 class="font-bold text-lg mb-2">Diseño 3D Gratuito</h3>
                  <p class="text-gray-500 text-sm">Visualiza cómo quedará tu {solucion.name} antes de fabricar. Optimizamos cada metro cuadrado.</p>
              </div>
              <div class="p-6">
                  <div class="w-12 h-12 bg-blue-50 text-invycta-blue rounded-full flex items-center justify-center mx-auto mb-4">
                      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  </div>
                  <h3 class="font-bold text-lg mb-2">Entrega Puntual</h3>
                  <p class="text-gray-500 text-sm">Sabemos que el alquiler corre. Cumplimos los plazos estrictamente para que abras a tiempo.</p>
              </div>
              <div class="p-6">
                  <div class="w-12 h-12 bg-blue-50 text-invycta-blue rounded-full flex items-center justify-center mx-auto mb-4">
                      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" /></svg>
                  </div>
                  <h3 class="font-bold text-lg mb-2">Precios de Fábrica</h3>
                  <p class="text-gray-500 text-sm">Sin intermediarios. Fabricamos en Ate y enviamos a todo el Perú.</p>
              </div>
          </div>
      </div>
  </section>

</Layout>