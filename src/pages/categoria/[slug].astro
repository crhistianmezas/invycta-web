---
// 1. MODO ESTÁTICO
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import type { Category, Product } from '../../types/cms';

// 2. GENERACIÓN DE RUTAS (GetStaticPaths)
// Esto le dice a Astro qué páginas crear basándose en tu Railway
export async function getStaticPaths() {
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
  
  try {
    const response = await fetch(`${API_URL}/category`);
    if (!response.ok) return []; // Si falla, no rompemos el build
    const categories: Category[] = await response.json();

    return categories.map((cat: Category) => ({
      params: { slug: cat.slug },
      props: { categoryData: cat }, // Pasamos los datos aquí para no volver a hacer fetch
    }));
  } catch (e) {
    console.error("Error construyendo rutas de categorías:", e);
    return [];
  }
}

// 3. RECUPERAR DATOS
export interface Props {
  categoryData: Category;
}
const { categoryData }: Props = Astro.props;

// Si por alguna razón entra aquí sin datos (raro en modo estático), redirigimos
if (!categoryData) {
  return Astro.redirect('/404');
}

const productos: Product[] = categoryData.products || [];
---

<Layout title={`${categoryData.name} | Invycta Retail`} description={`Catálogo de ${categoryData.name} para equipamiento comercial.`}>
  
  <section class="bg-gray-50 py-12 border-b border-gray-100">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl">
        <span class="text-invycta-blue font-bold tracking-widest text-xs uppercase mb-2 block">Catálogo de Productos</span>
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4">{categoryData.name}</h1>
        <p class="text-gray-600 text-lg max-w-2xl">{categoryData.description || `Encuentra los mejores productos de ${categoryData.name} con la calidad de Invycta Retail.`}</p>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container mx-auto px-4">
      
      {productos.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-8">
          {productos.map((prod: Product) => (
            <a href={`/producto/${prod.slug}`} class="group block bg-white border border-gray-100 rounded-xl overflow-hidden hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
              <div class="aspect-square bg-gray-100 relative overflow-hidden">
                {prod.image ? (
                   <img src={prod.image} alt={prod.name} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" loading="lazy" />
                ) : (
                   <div class="w-full h-full flex items-center justify-center text-gray-300 bg-gray-50"><span class="text-xs">Sin imagen</span></div>
                )}
                <span class="absolute top-3 left-3 bg-green-500 text-white text-[10px] font-bold px-2 py-1 rounded-full uppercase tracking-wider">Disponible</span>
              </div>
              <div class="p-5">
                <h3 class="font-bold text-gray-900 text-lg mb-1 group-hover:text-invycta-blue transition">{prod.name}</h3>
                <div class="flex justify-between items-center mt-4">
                   <span class="text-invycta-blue font-bold text-sm">Ver detalles</span>
                   <span class="w-8 h-8 rounded-full bg-blue-50 text-invycta-blue flex items-center justify-center group-hover:bg-invycta-blue group-hover:text-white transition">→</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-20 bg-gray-50 rounded-2xl border-2 border-dashed border-gray-200">
          <h3 class="text-xl font-bold text-gray-900">Catálogo en actualización</h3>
          <p class="text-gray-500 mt-2">Estamos subiendo nuevos modelos de {categoryData.name}.</p>
          <a href="https://wa.me/51955271064" class="inline-block mt-6 text-invycta-blue font-bold hover:underline">Consultar stock por WhatsApp →</a>
        </div>
      )}

    </div>
  </section>

</Layout>