---
// src/components/Header.astro
const API_URL = import.meta.env.DATABASE_URL_PUBLIC_API_URL || 'http://localhost:3000';

// 1. CARGA DE DATOS (Server Side)
let soluciones = [];
let categorias = [];

try {
  // Petición paralela para velocidad máxima
  const [resSoluciones, resCategorias] = await Promise.all([
    fetch(`${API_URL}/business-line`),
    fetch(`${API_URL}/category`)
  ]);

  if (resSoluciones.ok) soluciones = await resSoluciones.json();
  if (resCategorias.ok) categorias = await resCategorias.json();
} catch (e) {
  console.error("🚨 Error cargando menú:", e);
  // Fallback silencioso
}

// Mapeo para URLs amigables
const getCatLink = (slug) => `/categoria/${slug}`;
const getSolLink = (slug) => `/soluciones/${slug}`;
---

<header class="fixed w-full top-0 z-50 shadow-md bg-white font-sans">
        
    <div id="top-bar" class="bg-gray-900 text-gray-400 text-[11px] py-2 text-center tracking-wide transition-all duration-300 overflow-hidden relative z-[60]">
        <div class="container mx-auto flex justify-between px-4">
            <span class="hidden md:inline">Horario de atención: Lunes a Sábado de 08:30 am a 06:00 pm</span>
            <span class="md:hidden mx-auto">Cotizaciones online 24/7</span>
         
            <div class="hidden md:flex gap-4">
                <a href="mailto:ventas@invyctaretail.com" class="hover:text-white transition" aria-label="Enviar correo a ventas">ventas@invyctaretail.com</a>
                <span class="text-gray-600">|</span>
                <a href="tel:+51955271064" class="hover:text-white transition" aria-label="Llamar a ventas">+51 955 271 064</a>
            </div>
        </div>
    </div>

    <div id="header-bar" class="bg-invycta-blue text-white py-4 relative z-[60] shadow-sm transition-all duration-300">
        <div class="container mx-auto px-4 flex justify-between items-center">
            
            <a href="/" id="logo-wrapper" class="flex items-center gap-3 group flex-shrink-0 transition-opacity duration-300" aria-label="Invycta Retail - Ir al inicio">
                <div class="w-10 h-10 bg-white text-invycta-blue flex items-center justify-center font-bold text-2xl rounded shadow-lg transform group-hover:rotate-3 transition">I</div>
                <div class="flex flex-col leading-none">
                     <span class="font-extrabold text-xl tracking-widest">INVYCTA</span>
                    <span class="text-[10px] tracking-[0.4em] text-blue-200">RETAIL</span>
                </div>
            </a>

            <div class="hidden lg:flex items-center gap-6">
                
                <div class="relative group">
                    <input 
                        type="text" 
                        placeholder="Buscar góndola..." 
                        aria-label="Buscar productos"
                        class="bg-blue-800/50 text-white placeholder-blue-300 text-sm rounded-full pl-4 pr-10 py-2 focus:outline-none focus:bg-white focus:text-gray-900 focus:placeholder-gray-400 transition-all w-48 focus:w-64 border border-blue-400/30"
                    >
                    <svg class="w-4 h-4 absolute right-3 top-2.5 text-blue-300 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>

                <a href="https://wa.me/51955271064" target="_blank" class="bg-yellow-500 hover:bg-yellow-400 text-gray-900 font-bold text-sm px-5 py-2.5 rounded-full shadow-lg hover:shadow-xl transition transform hover:-translate-y-0.5 flex items-center gap-2" aria-label="Cotizar ahora por WhatsApp">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.017-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                    COTIZAR AHORA
                </a>
            </div>
          
            <button id="menu-btn" aria-label="Abrir menú principal" class="lg:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5 focus:outline-none z-50 relative border border-white/20 rounded hover:bg-white/10 transition-colors">
                <span class="block w-6 h-[2px] bg-white rounded-full transition-all duration-300 origin-center" id="line-top"></span>
                <span class="block w-6 h-[2px] bg-white rounded-full transition-all duration-300 origin-center" id="line-mid"></span>
                <span class="block w-6 h-[2px] bg-white rounded-full transition-all duration-300 origin-center" id="line-bottom"></span>
            </button>
            
        </div>
    </div>

    <div class="hidden lg:block bg-white border-b border-gray-100 relative z-40 h-14">
        <div class="container mx-auto px-4 h-full flex items-center h-full">
            <nav class="flex justify-center h-full w-full">
                <ul class="flex items-center gap-0 text-[13px] font-bold text-gray-700 uppercase tracking-wider">
                    
                    <li class="group relative h-full flex items-center">
                        <a href="/productos" class="h-full flex items-center gap-1 px-6 hover:bg-invycta-blue hover:text-white transition-colors">
                            PRODUCTOS
                            <svg class="w-3 h-3 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                        </a>
                        <div class="absolute top-full left-0 w-[632px] bg-white shadow-2xl rounded-b-xl border-t-4 border-yellow-500 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-2 group-hover:translate-y-0 z-50 overflow-hidden">
                            <div class="p-6 grid grid-cols-2 gap-x-8 gap-4">
                                {categorias.length > 0 ? categorias.map((cat) => (
                                    <a href={getCatLink(cat.slug)} class="flex items-center gap-3 p-2 hover:bg-blue-50 rounded-lg transition group/item">
                                        <div class="w-10 h-10 bg-gray-100 rounded flex items-center justify-center text-gray-400 group-hover/item:text-invycta-blue group-hover/item:bg-white transition">
                                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
                                        </div>
                                        <div>
                                            <span class="block text-gray-800 group-hover/item:text-invycta-blue font-bold text-xs">{cat.name}</span>
                                            <span class="block text-gray-400 text-[10px] normal-case">Ver catálogo completo</span>
                                        </div>
                                    </a>
                                )) : (
                                    <p class="text-xs text-gray-400 p-2 col-span-2 text-center">Cargando categorías...</p>
                                )}
                            </div>
                        </div>
                    </li>

                    <li class="group relative h-full flex items-center">
                        <a href="/soluciones" class="h-full flex items-center gap-1 px-6 hover:bg-invycta-blue hover:text-white transition-colors">
                            SOLUCIONES
                            <svg class="w-3 h-3 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                        </a>
                        <div class="absolute top-full left-0 w-[150px] bg-white shadow-2xl rounded-b-xl border-t-4 border-yellow-500 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-2 group-hover:translate-y-0 z-50 overflow-hidden">
                            <ul class="py-2">
                                {soluciones.length > 0 ? soluciones.map((sol) => (
                                    <li><a href={getSolLink(sol.slug)} class="block px-6 py-2.5 hover:bg-blue-50 text-gray-600 hover:text-invycta-blue text-xs transition-colors border-b border-gray-50 last:border-0">{sol.name}</a></li>
                                )) : (
                                    <li class="px-5 py-2 text-xs text-gray-400">Pronto disponible</li>
                                )}
                            </ul>
                         </div>
                    </li>

                    <li class="group relative h-full flex items-center">
                        <a href="/proyectos" class="h-full flex items-center gap-1 px-6 hover:bg-invycta-blue hover:text-white transition-colors">
                            PROYECTOS
                        </a>
                    </li>
                    <li class="group relative h-full flex items-center">
                        <a href="/blog" class="h-full flex items-center gap-1 px-6 hover:bg-invycta-blue hover:text-white transition-colors">
                            BLOG
                        </a>
                    </li>
                    <li class="group relative h-full flex items-center">
                        <a href="/contacto" class="h-full flex items-center gap-1 px-6 hover:bg-invycta-blue hover:text-white transition-colors">
                            CONTACTO
                        </a>
                    </li>

                </ul>
            </nav>
        </div>
    </div>

    <nav id="mobile-menu" class="fixed inset-0 w-full h-screen bg-white z-[50] flex flex-col pt-[110px] transition-all duration-300 transform translate-x-full lg:hidden">
        
        <div class="flex-1 overflow-y-auto px-6 py-4">
            <span class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4 block">Navegación</span>
            <ul class="space-y-1">
                
                <li>
                    <button class="w-full flex justify-between items-center py-4 text-lg font-bold text-gray-800 border-b border-gray-100" onclick="toggleSubmenu('mobile-products')" aria-label="Desplegar productos">
                        PRODUCTOS
                        <svg class="w-4 h-4 transition-transform" id="arrow-mobile-products" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                    </button>
                    <ul id="mobile-products" class="hidden pl-4 bg-gray-50 rounded-lg my-2 space-y-2 py-3">
                        {categorias.map((cat) => (
                            <li><a href={getCatLink(cat.slug)} class="block py-2 text-gray-600 font-medium text-sm">{cat.name}</a></li>
                        ))}
                    </ul>
                </li>

                <li>
                    <button class="w-full flex justify-between items-center py-4 text-lg font-bold text-invycta-blue border-b border-gray-100" onclick="toggleSubmenu('mobile-solutions')" aria-label="Desplegar soluciones">
                        SOLUCIONES
                        <svg class="w-4 h-4 transition-transform text-invycta-blue" id="arrow-mobile-solutions" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                    </button>
                    <ul id="mobile-solutions" class="hidden pl-4 bg-blue-50/50 rounded-lg my-2 space-y-2 py-3">
                        {soluciones.map((sol) => (
                            <li><a href={getSolLink(sol.slug)} class="block py-2 text-gray-600 font-medium text-sm">{sol.name}</a></li>
                        ))}
                    </ul>
                </li>

                <li><a href="/proyectos" class="block py-4 text-lg font-bold text-gray-800 border-b border-gray-100">PROYECTOS</a></li>
                <li><a href="/blog" class="block py-4 text-lg font-bold text-gray-800 border-b border-gray-100">BLOG</a></li>
            </ul>
        </div>

        <div class="p-6 bg-gray-50 border-t border-gray-100">
            <a href="https://wa.me/51955271064" class="block w-full bg-[#25D366] text-white font-bold text-lg py-4 rounded-xl text-center shadow-md mb-2">
                 WhatsApp Ventas
            </a>
            <p class="text-center text-gray-400 text-[10px] uppercase tracking-widest mt-4">Invycta Retail © 2026</p>
        </div>
    </nav>

</header>

<div class="h-[100px] lg:h-[100px]"></div>

<script is:inline>
    // Lógica del Menú Móvil
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('mobile-menu');
    const body = document.body;
    
    // Líneas del botón
    const lineTop = document.getElementById('line-top');
    const lineMid = document.getElementById('line-mid');
    const lineBottom = document.getElementById('line-bottom');

    let isOpen = false;
    if (btn && menu) {
        btn.addEventListener('click', () => {
            isOpen = !isOpen;
            
            if (isOpen) {
                // Abrir
                menu.classList.remove('translate-x-full');
                body.style.overflow = 'hidden';
                
                // Animación Hamburguesa -> X
                lineTop.classList.add('rotate-45', 'translate-y-[8px]');
                lineMid.style.opacity = '0';
                lineBottom.classList.add('-rotate-45', '-translate-y-[8px]');
            } else {
                // Cerrar
                menu.classList.add('translate-x-full');
                body.style.overflow = '';

                // Restaurar Hamburguesa
                lineTop.classList.remove('rotate-45', 'translate-y-[8px]');
                lineMid.style.opacity = '1';
                lineBottom.classList.remove('-rotate-45', '-translate-y-[8px]');
            }
        });
    }

    // Función global para los acordeones móviles
    window.toggleSubmenu = (id) => {
        const submenu = document.getElementById(id);
        const arrow = document.getElementById('arrow-' + id);
        if (submenu) {
            submenu.classList.toggle('hidden');
            arrow.classList.toggle('rotate-180');
        }
    }
</script>