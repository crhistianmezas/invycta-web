generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // 👈 PRISMA 7 a veces requiere que especifiques que no estás usando Accelerate si el error persiste
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  fullName          String
  passwordHash      String
  role              Role              @default(SALES_AGENT)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  projectsCreated   Project[]         @relation("Creator")
  projectsSold      Project[]         @relation("SalesAgent")
  filesUploaded     ProjectFile[]
  materialsDeclared ProjectMaterial[]
}

model Client {
  id           String    @id @default(uuid())
  businessName String
  taxId        String?
  contactName  String?
  phone        String
  email        String?
  address      String?
  createdAt    DateTime  @default(now())
  projects     Project[]
}

model Project {
  id             String            @id @default(uuid())
  code           String            @unique
  title          String
  description    String?
  type           ProjectType
  status         ProjectStatus     @default(NUEVO_LEAD)
  currency       String            @default("PEN")
  totalAmount    Decimal           @db.Decimal(10, 2)
  advancePayment Decimal?          @db.Decimal(10, 2)
  deadlineDate   DateTime?
  dispatchDate   DateTime?
  opsApprovedAt  DateTime?
  qcStatus       String?
  qcNotes        String?
  carrierInfo    String?
  clientId       String
  salesAgentId   String
  createdById    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  client         Client            @relation(fields: [clientId], references: [id])
  createdBy      User              @relation("Creator", fields: [createdById], references: [id])
  salesAgent     User              @relation("SalesAgent", fields: [salesAgentId], references: [id])
  files          ProjectFile[]
  materialsUsed  ProjectMaterial[]
}

model ProjectFile {
  id          String   @id @default(uuid())
  fileUrl     String
  fileType    FileType
  description String?
  projectId   String
  uploaderId  String
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id])
  uploader    User     @relation(fields: [uploaderId], references: [id])
}

model InventoryItem {
  id            String            @id
  name          String
  unit          MaterialUnit
  currentStock  Decimal           @db.Decimal(10, 2)
  minStockAlert Int               @default(5)
  costPrice     Decimal           @db.Decimal(10, 2)
  updatedAt     DateTime          @updatedAt
  materialsUsed ProjectMaterial[]
}

model ProjectMaterial {
  id           String        @id @default(uuid())
  quantity     Decimal       @db.Decimal(10, 2)
  projectId    String
  materialId   String
  declaredById String
  declaredAt   DateTime      @default(now())
  declaredBy   User          @relation(fields: [declaredById], references: [id])
  material     InventoryItem @relation(fields: [materialId], references: [id])
  project      Project       @relation(fields: [projectId], references: [id])
}

model WebContent {
  id           String   @id @default(uuid())
  sectionType  String
  title        String?
  subtitle     String?
  description  String?
  imageUrl     String?
  ctaText      String?  @default("COTIZA AQUÍ")
  ctaLink      String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  OPS_MANAGER
  SALES_AGENT
  MARKETING
  MACHINE_OPERATOR
  ASSEMBLY_TEAM
}

enum ProjectType {
  VENTA_DIRECTA
  APERTURA_LOCAL
  REMODELACION
  SERVICIO_CORTE
}

enum ProjectStatus {
  NUEVO_LEAD
  EN_COTIZACION
  CONFIRMADO_VENTA
  VALIDACION_OPS
  EN_INGENIERIA
  EN_CORTE
  EN_ARMADO
  CONTROL_CALIDAD
  LISTO_DESPACHO
  ENTREGADO
  CANCELADO
}

enum FileType {
  PLANO_CLIENTE
  COTIZACION_PDF
  MODELO_SKETCHUP
  DESPIECE_TECNICO
  EVIDENCIA_CALIDAD
  GUIA_REMISION
  COMPROBANTE_PAGO
}

enum MaterialUnit {
  PLANCHA
  METRO_LINEAL
  UNIDAD
  CAJA
  LITRO
}
